local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

getgenv().PropTarget = nil
getgenv().PropMode = "Kill" 
getgenv().AntiTarget = nil

local isSpawning = false
local propReady = false

local function GetPlayerList()
    local t = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then table.insert(t, plr.Name) end
    end
    return t
end

local function GetMyProps()
    local props = {}
    local workspaceCom = workspace:FindFirstChild("WorkspaceCom")
    if not workspaceCom then return props end
    local myName = LocalPlayer.Name
    for _, folder in ipairs(workspaceCom:GetChildren()) do
        for _, prop in ipairs(folder:GetChildren()) do
            if prop.Name:find(myName) and prop:FindFirstChild("SetCurrentCFrame") then
                table.insert(props, prop)
            end
        end
    end
    return props
end

local function TeleportProps(targetCFrame)
    for _, prop in ipairs(GetMyProps()) do
        task.spawn(function()
            pcall(function()
                prop.SetCurrentCFrame:InvokeServer(targetCFrame)
            end)
        end)
    end
end

local function ClearAllProps()
    pcall(function()
        ReplicatedStorage.RE:FindFirstChild("1Clea1rTool1s"):FireServer("ClearAllProps")
    end)
end

local function AutoSpawnProp()
    if isSpawning then return end
    if #GetMyProps() > 0 then 
        propReady = true
        return 
    end

    isSpawning = true
    propReady = false

    local RE = ReplicatedStorage:WaitForChild("RE", 5)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then 
        isSpawning = false 
        return 
    end
    local root = char.HumanoidRootPart

    pcall(function()
        RE:FindFirstChild("1Clea1rTool1s"):FireServer("ClearAllProps")
    end)
    task.wait(0.3)

    local hasTool = char:FindFirstChild("PropMaker") or LocalPlayer.Backpack:FindFirstChild("PropMaker")
    if not hasTool then
        pcall(function()
            RE:WaitForChild("1Too1l"):InvokeServer("PickingTools", "PropMaker")
        end)
        task.wait(1)
    end

    local tool = LocalPlayer.Backpack:FindFirstChild("PropMaker") or char:FindFirstChild("PropMaker")
    if tool and tool.Parent == LocalPlayer.Backpack then
        pcall(function() char:FindFirstChild("Humanoid"):EquipTool(tool) end)
        task.wait(1)
    end

    if not char:FindFirstChild("PropMaker") then
        isSpawning = false
        return
    end

    pcall(function()
        RE:WaitForChild("1Clea1rTool1s"):FireServer("RequestingPropName", "FurnitureChairBlackBig", "Furniture")
    end)
    task.wait(1)

    local spawnTarget = workspace:FindFirstChild("Baseplate") or workspace:FindFirstChildWhichIsA("Terrain")
    if not spawnTarget then
        local model = workspace:FindFirstChild("Model")
        if model then spawnTarget = model:FindFirstChild("Sidewalk") end
    end
    
    if spawnTarget then
        pcall(function()
            char.PropMaker:WaitForChild("Tool_PropMake"):FireServer(
                spawnTarget,
                root.Position - Vector3.new(0, 5, 0)
            )
        end)
    end
    
    task.wait(0.5)

    isSpawning = false
    propReady = true
end

