local PropLoopRunning = false
PropsTab:CreateToggle({
   Name = "Start",
   CurrentValue = false,
   Flag = "PropEngineToggle",
   Callback = function(Value)
      PropLoopRunning = Value
      if Value then
          task.spawn(AutoSpawnProp)
          
          task.spawn(function()
              while PropLoopRunning do
                  if not propReady and not isSpawning and #GetMyProps() == 0 then
                      task.spawn(AutoSpawnProp)
                  end

                  if propReady and #GetMyProps() > 0 then
                      local target = getgenv().PropTarget
                      local mode = getgenv().PropMode
                      
                      if target and target.Parent and target.Character then
                          local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                          local targetHum = target.Character:FindFirstChild("Humanoid")
                          local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                          
                          if targetRoot and targetHum and targetHum.Health > 0 then
                              
                              if mode == "Kill" then
                                  if not targetHum.Sit then
                                      TeleportProps(targetRoot.CFrame * CFrame.new(0, -(targetHum.HipHeight + 1), 0))
                                  else
                                      TeleportProps(CFrame.new(216.457, -1338.86, -477.942))
                                      ClearAllProps()
                                      propReady = false
                                      task.spawn(AutoSpawnProp)
                                      task.wait(0.15)
                                  end
                                  
                              elseif mode == "Fling" then
                                  if not targetHum.Sit then
                                      TeleportProps(targetRoot.CFrame * CFrame.new(0, -(targetHum.HipHeight + 1), 0))
                                  else
                                      for i = 1, 5 do
                                          TeleportProps(CFrame.new(math.random(100000, 999999), math.random(100000, 999999), math.random(100000, 999999)))
                                          task.wait(0.01)
                                      end
                                      ClearAllProps()
                                      propReady = false
                                      task.spawn(AutoSpawnProp)
                                      task.wait(0.3)
                                  end
                                  
                              elseif mode == "Bring" and myRoot then
                                  if not targetHum.Sit then
                                      TeleportProps(targetRoot.CFrame * CFrame.new(0, -(targetHum.HipHeight + 1), 0))
                                  else
                                      for i = 1, 10 do
                                          TeleportProps(myRoot.CFrame * CFrame.new(0, 0, -3))
                                          task.wait(0.03)
                                      end
                                      ClearAllProps()
                                      propReady = false
                                      task.spawn(AutoSpawnProp)
                                      task.wait(0.3)
                                  end
                              end
                          end
                      end
                  end
                  task.wait(0.05)
              end
          end)
      else
          propReady = false
      end
   end,
})

PropsTab:CreateButton({
   Name = "Clear Props",
   Callback = function()
       ClearAllProps()
       propReady = false
   end,
})

PropsTab:CreateSection("Visuals")

local RGBRunning = false
PropsTab:CreateToggle({
   Name = "RGB",
   CurrentValue = false,
   Flag = "PropRGB",
   Callback = function(Value)
      RGBRunning = Value
      if not Value then return end
      task.spawn(function()
          while RGBRunning do
              local hue = (tick() * 0.5) % 1
              local color = Color3.fromHSV(hue, 1, 1)
              for _, prop in ipairs(GetMyProps()) do
                  pcall(function() prop.ChangePropColor:InvokeServer(color) end)
              end
              pcall(function()
                  LocalPlayer.PlayerGui:WaitForChild("NoResetGUIHandler")
                      :WaitForChild("PropColorPicker")
                      :WaitForChild("SetColor"):FireServer(color)
              end)
              task.wait(0.1)
          end
      end)
   end,
})

local OrbitRunning = false
PropsTab:CreateToggle({
   Name = "Orbit",
   CurrentValue = false,
   Flag = "OrbitProp",
   Callback = function(Value)
      OrbitRunning = Value
      if not Value then return end
      local speed, radius, heightOffset, angle = 3, 6, -3, 0
      task.spawn(function()
          while OrbitRunning do
              local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
              local props = GetMyProps()
              if root and #props > 0 then
                  angle += 0.05 * speed
                  local spacing = (math.pi * 2) / #props
                  for i, prop in ipairs(props) do
                      if prop and prop.Parent then
                          local currentAngle = angle + (i * spacing)
                          local worldPos = root.Position + Vector3.new(math.cos(currentAngle) * radius, heightOffset, math.sin(currentAngle) * radius)
                          pcall(function()
                              prop.SetCurrentCFrame:InvokeServer(CFrame.lookAt(worldPos, root.Position))
                          end)
                      end
                  end
              end
              task.wait(0.03)
          end
      end)
   end,
})

