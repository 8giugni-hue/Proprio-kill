local PropsTab = Window:CreateTab("Props", 4483362458)

local selectedPlayer = nil
local function GetPlayerList()
    local t = {}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            table.insert(t, plr.Name)
        end
    end
    return t
end

local function UpdateTargetPlayer(playerName)
    if playerName and playerName ~= "" then
        selectedPlayer = Players:FindFirstChild(playerName)
        getgenv().PropTarget = selectedPlayer
    else
        selectedPlayer = nil
        getgenv().PropTarget = nil
    end
end

