AntiToolsTab:CreateToggle({
   Name = "Anti Tools (Single)",
   CurrentValue = false,
   Flag = "AntiSingle",
   Callback = function(Value)
      loopAtivo = Value
      if Value then
        local targetName = getgenv().AntiTarget or antiToolsSelectedPlayer
        if not targetName or targetName == "" then 
           warn("Nenhum alvo selecionado!")
           loopAtivo = false
           return 
        end
        
        task.spawn(function()
           while loopAtivo do
              pcall(function()
                local alvo = Players:FindFirstChild(targetName)
                if alvo and alvo.Character then
                    local tool = alvo.Character:FindFirstChildOfClass("Tool")
                    if tool then
                       local triggerRemote = ReplicatedStorage.RE:FindFirstChild("1Playe1rTrigge1rEven1t")
                       local clearRemote = ReplicatedStorage.RE:FindFirstChild("1Clea1rTool1s")
                       if triggerRemote and clearRemote then
                          triggerRemote:FireServer("AcceptedToolToServer", tool.Name, alvo)
                          clearRemote:FireServer("ClearAllTools")
                       end
                    end
                end
              end)
              task.wait(0.1) -- Slightly raised from 0.01 to prevent server crashing/yielding
           end
        end)
      end
   end,
})

